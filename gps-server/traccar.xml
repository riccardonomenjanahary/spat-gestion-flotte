<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">

<properties>

    <!-- Configuration Traccar standard -->
    <entry key="config.default">./conf/default.xml</entry>


    <!-- ===================================================== -->
    <!-- TRACCAR UTILISE UNIQUEMENT COMME PASSERELLE GPS       -->
    <!-- ===================================================== -->

    <!-- Pas de base Traccar persistante -->
    <entry key="database.memory">true</entry>

    <!-- Accepter automatiquement les traceurs inconnus -->
    <entry key="database.registerUnknown">true</entry>


    <!-- ===================================================== -->
    <!-- PROTOCOLE GPS                                         -->
    <!-- ===================================================== -->

    <!-- On active uniquement GPS103 -->
    <entry key="protocols.enable">gps103</entry>

    <!-- Port GPS103 -->
    <entry key="gps103.port">5001</entry>


    <!-- ===================================================== -->
    <!-- TRANSFERT VERS SPRING BOOT SPAT                       -->
    <!-- ===================================================== -->

    <entry key="forward.type">json</entry>

    <entry key="forward.url">
        http://host.docker.internal:8080/internal/gps/positions
    </entry>

    <!-- Réessayer si Spring Boot est temporairement indisponible -->
    <entry key="forward.retry.enable">true</entry>


    <!-- ===================================================== -->
    <!-- FONCTIONS INUTILES DESACTIVEES                        -->
    <!-- ===================================================== -->

    <entry key="filter.enable">false</entry>

    <entry key="geocoder.enable">false</entry>

    <entry key="geolocation.enable">false</entry>

    <entry key="speedLimit.enable">false</entry>

    <entry key="server.statistics"></entry>

</properties>